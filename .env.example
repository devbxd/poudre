# Copy this file to .env and fill in the values (.env is never committed)

WP_URL=https://poudrebeauty.com

# WooCommerce > Settings > Advanced > REST API > Add key  (Permissions: Read/Write)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Users > Profile (admin) > Application Passwords > "claude-dashboard" > Add
WP_USER=admin_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
